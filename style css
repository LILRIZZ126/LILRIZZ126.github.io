/* ===== LILRIZZ PREMIUM BACKGROUND ===== */

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(255, 75, 0, 0.20),
            transparent 35%
        ),
        radial-gradient(
            circle at 85% 60%,
            rgba(255, 0, 50, 0.13),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #080808,
            #17100e,
            #090909
        );
    color: #ffffff;
}

/* HERO SECTION */

.hero {
    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,0.95),
            rgba(20,10,5,0.65),
            rgba(0,0,0,0.25)
        ),
        url("https://images.unsplash.com/photo-1569718212165-3a8278d5f624")
        center/cover no-repeat;

    min-height: 90vh;
    position: relative;
}

/* MENU SECTION */

.menu,
.about,
.contact {
    background: transparent;
}

/* MENU CARD */

.menu-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,100,30,0.25);
    border-radius: 18px;
    backdrop-filter: blur(12px);
    transition: 0.3s ease;
}

.menu-card:hover {
    transform: translateY(-8px);
    border-color: #ff5a1f;
    box-shadow: 0 10px 35px rgba(255,70,0,0.2);
}

/* BUTTON */

button,
.btn {
    background: linear-gradient(
        135deg,
        #ff6a00,
        #ff2500
    );
    color: white;
    border: none;
    border-radius: 30px;
    transition: 0.3s;
}

button:hover,
.btn:hover {
    transform: scale(1.05);
    box-shadow: 0 0 20px rgba(255,80,0,0.5);
}
